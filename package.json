{
  "name": "milestone-payfi",
  "version": "0.1.0",
  "private": true,
  "description": "Milestone PayFi MVP for programmable work-contract settlement on Arc.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:onchain": "node scripts/verify-onchain-flow.mjs",
    "agent:register": "tsx --env-file-if-exists=.env.local agents/register-identity.ts",
    "agent:underwrite": "tsx --env-file-if-exists=.env.local agents/underwriter.ts",
    "agent:settle": "tsx --env-file-if-exists=.env.local agents/settler.ts",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "contracts:deploy:arc": "node scripts/deploy-arc-testnet.mjs",
    "contracts:test": "forge test"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.14.0",
    "@circle-fin/app-kit": "^1.10.0",
    "@tanstack/react-query": "^5.101.2",
    "lucide-react": "^0.468.0",
    "next": "^14.2.5",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.53.1",
    "wagmi": "^3.6.21",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "playwright-core": "^1.61.1",
    "solc": "^0.8.35",
    "tsx": "^4.23.1",
    "typescript": "^5.5.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
